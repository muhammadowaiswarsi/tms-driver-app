{
  "expo": {
    "name": "Driver Mobile App",
    "slug": "driver-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.driverapp.mobile",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationWhenInUseUsageDescription": "Allow Driver Mobile App to share your location with dispatch while on shift.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Driver Mobile App to share your location with dispatch even when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "Allow Driver Mobile App to share your location with dispatch even when the app is in the background."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.driverapp.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Driver Mobile App to share your location with dispatch even when the app is in the background.",
          "locationAlwaysPermission": "Allow Driver Mobile App to share your location with dispatch even when the app is in the background.",
          "locationWhenInUsePermission": "Allow Driver Mobile App to share your location with dispatch while on shift.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "driverapp",
    "extra": {
      "apiUrl": "http://localhost:8080/api",
      "router": {},
      "eas": {
        "projectId": "12e5d8c6-1bff-42ba-b748-c4bc4809f6bc"
      }
    }
  }
}
